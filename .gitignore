# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
pubspec_overrides.yaml

# This is an application, so the resolved lockfile is committed for
# reproducible builds. Overrides a global *.lock rule if one is set.
!pubspec.lock

# The README is this repository's documentation and ships with it. Overrides a
# global README.md rule if one is set.
!README.md

# Tool-generated, regenerated by `flutter pub get`
.flutter-plugins
.flutter-plugins-dependencies

# Generated sources
**/lib/l10n/generated/
*.g.dart
*.freezed.dart
*.gen.dart
*.mocks.dart

# Secrets — only env/example.json is tracked
env/*
!env/example.json

